# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Values here are placeholders only.

# Telegram (milestone J6)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Local model server (milestone J7) — LM Studio, OpenAI-compatible.
# Use the address LM Studio listens on (localhost, or your Mac's Tailscale name).
LOCAL_MODEL_BASE_URL=http://localhost:1234/v1
# Exact id as listed by: curl -s <LOCAL_MODEL_BASE_URL>/models
LOCAL_MODEL_ID=

# PostgreSQL (milestone J3) — local only, bound to 127.0.0.1.
# Owner: migrations only. App: INSERT/SELECT only. 16+ chars of [A-Za-z0-9_-].
# Generate each with: openssl rand -hex 24
CENACLE_DB_PORT=55432
CENACLE_DB_OWNER_PASSWORD=
CENACLE_DB_APP_PASSWORD=
