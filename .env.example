# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Values here are placeholders only.

# Telegram (milestone J6)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Local model server (milestone J7) — LM Studio, OpenAI-compatible.
# Use the address LM Studio listens on (localhost, or your Mac's Tailscale name).
LOCAL_MODEL_BASE_URL=http://localhost:1234/v1
# Exact id as listed by: curl -s <LOCAL_MODEL_BASE_URL>/models
LOCAL_MODEL_ID=

# PostgreSQL (milestone J3) — local only, bound to 127.0.0.1.
# Owner: migrations only. App: INSERT/SELECT only. 16+ chars of [A-Za-z0-9_-].
# Generate each with: openssl rand -hex 24
CENACLE_DB_PORT=55432
CENACLE_DB_OWNER_PASSWORD=
CENACLE_DB_APP_PASSWORD=

# Observability (milestone J8) — start with: npm run obs:up
# Traces go to the local Tempo only (the code refuses any non-local endpoint).
CENACLE_OTEL_ENDPOINT=http://127.0.0.1:4318
# Grafana admin password (http://127.0.0.1:3000). Generate: openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=

# Test mailbox (phase 2) — local GreenMail, fictional mails only.
# Never a real mailbox password. Generate: openssl rand -hex 16
CENACLE_TEST_MAIL_PASSWORD=

# Mail memory keys (phase 3, ADR-0012) — addresses and thread ids are stored
# only as HMAC keys under this secret. Keep a backup: losing it makes the
# memory unusable (it is then emptied and re-read). Generate: openssl rand -hex 32
CENACLE_MAIL_KEY=

# Signed acceptances (phase 4, B6, ADR-0013) — only the page can accept.
# Generate the pair with: npm run keys:accept
# The PRIVATE key is written to .env.page (git-ignored), which only
# `npm run server` loads; never put it here: Iris and the executor refuse to
# start if they find it. The PUBLIC key goes here, for the executor.
CENACLE_ACCEPT_PUBLIC_KEY=

# The executor's database role (phase 4, B7, ADR-0013) — the only role allowed
# to claim and close a sending. Its password goes to .env.executor
# (git-ignored), which only `npm run executor` and `npm run db:migrate` load
# (and the tests, for the test database). Never put it here: Iris and the page
# refuse to start if they find it. Create the file with:
#   printf 'CENACLE_DB_EXECUTOR_PASSWORD=%s\n' "$(openssl rand -hex 24)" > .env.executor && chmod 600 .env.executor
