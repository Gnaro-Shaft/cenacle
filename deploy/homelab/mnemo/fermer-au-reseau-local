#!/bin/bash
# Fermer Mnemo et Ollama au reseau local, puis le PROUVER.
#
#   deploy/homelab/mnemo/fermer-au-reseau-local <root@machine-de-mnemo> <compte@temoin>
#
# Depuis le Mac, a la racine du depot. Voir README.md. <temoin> : une machine
# du reseau local, d'ou l'on tente les ports. Aucune des deux n'est ecrite ici,
# ni l'adresse du tailnet : elle est lue sur la machine (ADR-0045).
#
# Ce qu'il pose sur la machine de Mnemo, chaque fois avec une copie de l'ancien :
#   - mnemo-api, mnemo-mcp : ecoute sur l'adresse du tailnet seulement ;
#   - Ollama : ecoute en boucle locale seulement ;
#   - le .env de Mnemo : MNEMO_OLLAMA_URL vers 127.0.0.1, droits en 600.
#
# Ce qu'il prouve, et c'est la raison d'etre du script :
#   - depuis le temoin, SUR LE RESEAU LOCAL, les quatre ports sont refuses —
#     avec un temoin : le port 22 de la meme adresse doit, lui, repondre,
#     sinon « refuse » voudrait seulement dire « injoignable » ;
#   - depuis le Mac, par le tailnet, l'API, le MCP et les metriques repondent ;
#   - Ollama repond en local, et le MCP cherche l'API a la bonne adresse.
#
# Rejouable : une surcharge deja posee est reposee a l'identique.
# Le contenu du .env n'est JAMAIS affiche — il porte des secrets.
#
# Aucun lecteur qui s'arrete tot (head, grep -q) derriere un tuyau : sous
# pipefail, l'ecrivain meurt de SIGPIPE et la ligne entiere echoue. C'est ce
# qui a casse porter-le-code a sa premiere utilisation.
set -euo pipefail
export LC_ALL=C

ICI="$(cd "$(dirname "$0")" && pwd)"
[ $# -eq 2 ] && [[ "$1" =~ ^root@[A-Za-z0-9._-]+$ ]] && [[ "$2" =~ ^[a-z_][a-z0-9_-]*@[A-Za-z0-9._-]+$ ]] || {
    echo "usage : fermer-au-reseau-local <root@machine-de-mnemo> <compte@temoin>" >&2
    exit 2
}
MACHINE="$1"
TEMOIN="$2"
ESSAIS="${MNEMO_ESSAIS:-30}"

ok()    { printf '  ok     %s\n' "$1"; }
echec() { printf '  ECHEC  %s\n' "$1" >&2; exit 1; }

echo "-- l'adresse du tailnet --"
# Les surcharges l'ecrivent en dur : c'est celle que la machine porte, ou rien.
# Une seule adresse, et du tailnet (100.64.0.0/10) — sinon les services se
# lieraient a ce qu'aurait ecrit une erreur.
TAILNET="$(ssh "$MACHINE" 'tailscale ip -4')" || echec "tailscale illisible"
[[ "$TAILNET" =~ ^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])(\.(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])){2}$ ]] ||
    echec "la machine repond « $TAILNET » : pas une adresse du tailnet"
ok "la machine de Mnemo est a $TAILNET"
ADRESSES="$(ssh "$MACHINE" "hostname -I")" || echec "adresses de la machine illisibles"
LOCALE="$(printf '%s\n' $ADRESSES | grep -E '^192\.168\.[0-9]{1,3}\.[0-9]{1,3}$' || true)"
LOCALE="${LOCALE%%$'\n'*}"
[ -n "$LOCALE" ] || echec "aucune adresse 192.168.* sur la machine : l'epreuve du reseau local est impossible"
ok "son adresse sur le reseau local : $LOCALE"

echo "-- copie --"
# Le modele rempli ici ; il ne doit plus rien porter a remplir.
LOCAL_TMP="$(mktemp -d)"
trap 'rm -rf "$LOCAL_TMP"' EXIT
sed "s/@TAILNET@/$TAILNET/g" "$ICI/ecoute-tailnet.conf" > "$LOCAL_TMP/ecoute-tailnet.conf"
! grep -q '@TAILNET@' "$LOCAL_TMP/ecoute-tailnet.conf" || echec "le modele n'est pas rempli"
cp "$ICI/ollama-override.conf" "$LOCAL_TMP/ollama-override.conf"
# Un dossier a soi, cree par root, plutot que /tmp/<nom connu> : un autre
# compte de la machine pourrait y avoir pose le fichier, ou un lien, d'avance.
DEPOT="$(ssh "$MACHINE" 'mktemp -d')" || echec "dossier de depot impossible sur la machine"
[[ "$DEPOT" =~ ^/tmp/tmp\.[A-Za-z0-9]+$ ]] || echec "dossier de depot inattendu : $DEPOT"
if ! scp -q "$LOCAL_TMP/ecoute-tailnet.conf" "$LOCAL_TMP/ollama-override.conf" "$MACHINE:$DEPOT/"; then
    ssh "$MACHINE" "rm -rf $DEPOT" || true
    echec "copie impossible : rien n'est pose"
fi
ok "surcharges copiees"

echo "-- pose --"
ssh "$MACHINE" "bash -s -- $DEPOT" <<'DISTANT'
set -euo pipefail
DEPOT="$1"
QUAND="$(date +%Y%m%d-%H%M%S)"
ENV=/root/projects/mnemo/.env
fin() { rm -rf "$DEPOT"; }
trap fin EXIT

# Le .env d'abord : une seule ligne change, et elle doit exister — sinon Mnemo
# lirait son adresse par defaut, qu'on ne connait pas. Rien n'est pose avant.
if ! grep -q '^MNEMO_OLLAMA_URL=' "$ENV" 2>/dev/null; then
    echo "  ECHEC  MNEMO_OLLAMA_URL absent de $ENV : rien n'est pose" >&2; exit 1
fi

# Ce que les surcharges changent vraiment, commentaires mis a part (le .env
# n'est pas compare) : rien, a une repose.
reglages() { grep -v '^#' "$1" 2>/dev/null || true; }
S=/etc/systemd/system
if [ "$(reglages "$S/mnemo-api.service.d/ecoute-tailnet.conf")" = "$(reglages "$DEPOT/ecoute-tailnet.conf")" ] &&
   [ "$(reglages "$S/mnemo-mcp.service.d/ecoute-tailnet.conf")" = "$(reglages "$DEPOT/ecoute-tailnet.conf")" ] &&
   [ "$(reglages "$S/ollama.service.d/override.conf")" = "$(reglages "$DEPOT/ollama-override.conf")" ]; then
    echo "  --     memes surcharges que celles en place"
else
    echo "  --     les surcharges en place changent"
fi

# Ollama : on remplace l'ancienne surcharge, gardee a cote. Un .bak n'est pas
# lu par systemd, qui ne lit que les *.conf.
D=/etc/systemd/system/ollama.service.d
install -d -m 755 "$D"
if [ -f "$D/override.conf" ]; then
    cp -p "$D/override.conf" "$D/override.conf.bak-avant-$QUAND"
fi
install -m 644 "$DEPOT/ollama-override.conf" "$D/override.conf"

for unite in mnemo-api mnemo-mcp; do
    install -d -m 755 "/etc/systemd/system/$unite.service.d"
    install -m 644 "$DEPOT/ecoute-tailnet.conf" "/etc/systemd/system/$unite.service.d/ecoute-tailnet.conf"
done

cp -p "$ENV" "$ENV.bak-avant-$QUAND"
chmod 600 "$ENV.bak-avant-$QUAND"
sed -i 's|^MNEMO_OLLAMA_URL=.*|MNEMO_OLLAMA_URL=http://127.0.0.1:11434|' "$ENV"
chmod 600 "$ENV"

systemctl daemon-reload
systemctl restart ollama.service
for _ in $(seq "${MNEMO_ATTENTE_OLLAMA:-20}"); do
    curl -sf -o /dev/null http://127.0.0.1:11434/api/version && break
    sleep 1
done
if ! curl -sf -o /dev/null http://127.0.0.1:11434/api/version; then
    echo "  ECHEC  Ollama ne repond pas en local apres redemarrage" >&2; exit 1
fi
systemctl restart mnemo-api.service mnemo-mcp.service mnemo-watch.service
echo "  ok     pose (copies : *.bak-avant-$QUAND)"
DISTANT

echo "-- les adresses d'ecoute --"
# uv met quelques secondes a relancer les services : on attend qu'ils ecoutent.
ATTENDU="$(printf '%s\n' "$TAILNET:8000" "$TAILNET:8001" "$TAILNET:8002" "127.0.0.1:11434" | sort | tr '\n' ' ')"
ECOUTE=""
for _ in $(seq "$ESSAIS"); do
    BRUT="$(ssh "$MACHINE" "ss -lntH '( sport = :8000 or sport = :8001 or sport = :8002 or sport = :11434 )'")" || BRUT=""
    ECOUTE="$(printf '%s\n' "$BRUT" | awk 'NF {print $4}' | sort | tr '\n' ' ')"
    [ "$ECOUTE" = "$ATTENDU" ] && break
    sleep 1
done
[ "$ECOUTE" = "$ATTENDU" ] || echec "ecoute « ${ECOUTE:-rien} », attendu « $ATTENDU »"
ok "8000, 8001, 8002 sur le tailnet ; 11434 en boucle locale"

echo "-- depuis le reseau local ($TEMOIN -> $LOCALE) --"
ssh "$TEMOIN" "bash -s -- $LOCALE" <<'DISTANT'
set -uo pipefail
LOCALE="$1"
ouvert() { timeout 3 bash -c "</dev/tcp/$LOCALE/$1" 2>/dev/null; }
# Le temoin d'abord : sans lui, un refus ne prouverait rien.
if ! ouvert 22; then
    echo "  ECHEC  temoin : le port 22 de $LOCALE ne repond pas — l'epreuve ne vaut rien" >&2; exit 1
fi
echo "  ok     temoin : le port 22 de $LOCALE repond"
for port in 8000 8001 8002 11434; do
    if ouvert "$port"; then
        echo "  ECHEC  le port $port repond encore sur le reseau local" >&2; exit 1
    fi
    echo "  ok     le port $port est ferme au reseau local"
done
DISTANT

echo "-- depuis le Mac, par le tailnet --"
code() { curl -s -o /dev/null -m 5 -w '%{http_code}' "$1" || true; }
# Ecouter n'est pas etre pret : le port s'ouvre avant que le service reponde.
# A la premiere pose reelle, l'API a ete jugee une seconde trop tot. On
# reessaie, et un echec dit ce qui a ete recu — sans quoi on devine.
attendre() {  # attendre <url> <motif egrep du code voulu>
    local recu=""
    for _ in $(seq "$ESSAIS"); do
        recu="$(code "$1")"
        grep -qE "^($2)\$" <<< "$recu" && { printf '%s' "$recu"; return 0; }
        sleep 1
    done
    printf '%s' "$recu"; return 1
}
RECU="$(attendre "http://$TAILNET:8000/healthz" "200")" ||
    echec "l'API ne repond pas 200 sur le tailnet (dernier code : ${RECU:-rien})"
ok "API : /healthz repond 200"
# Un GET nu n'est pas une requete MCP valide : on veut une reponse HTTP, pas
# un succes. 000 voudrait dire « personne ».
MCP="$(attendre "http://$TAILNET:8001/mcp" "[1-5][0-9][0-9]")" ||
    echec "le MCP ne repond pas sur le tailnet (dernier code : ${MCP:-rien})"
ok "MCP : repond (HTTP $MCP a un GET nu, comme attendu)"
RECU="$(attendre "http://$TAILNET:8002/metrics" "200")" ||
    echec "les metriques ne repondent pas sur le tailnet (dernier code : ${RECU:-rien})"
ok "metriques : repondent"
[ "$(code "http://$TAILNET:11434/api/version")" = "000" ] || echec "Ollama repond encore sur le tailnet"
ok "Ollama : ferme au tailnet aussi"

echo "-- le MCP joint l'API --"
# Une vraie session MCP, puis l'outil « stats » : il oblige le MCP a appeler
# l'API. C'est la preuve que MNEMO_MCP_API_URL a pris — lire le journal ne
# l'etait pas : Rich y renvoie la valeur a la ligne, et le premier controle,
# qui la cherchait sur une seule ligne, a crie a tort le 25/09/2026.
# « stats » et non « search_vault » : des compteurs, jamais le texte d'une note.
# La reponse n'est pas affichee, seulement jugee.
MCP_URL="http://$TAILNET:8001/mcp"
ACCEPTE="Accept: application/json, text/event-stream"
ENTETES="$(curl -s -m 10 -D - -o /dev/null -X POST -H "Content-Type: application/json" -H "$ACCEPTE" \
    -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-03-26","capabilities":{},"clientInfo":{"name":"fermer-au-reseau-local","version":"1"}}}' \
    "$MCP_URL" || true)"
SESSION="$(printf '%s\n' "$ENTETES" | tr -d '\r' | awk -F': ' 'tolower($1) == "mcp-session-id" {print $2}')"
[ -n "$SESSION" ] || echec "le MCP n'a pas ouvert de session"
curl -s -m 10 -o /dev/null -X POST -H "Content-Type: application/json" -H "$ACCEPTE" \
    -H "mcp-session-id: $SESSION" -d '{"jsonrpc":"2.0","method":"notifications/initialized"}' \
    "$MCP_URL" || true
STATS="$(curl -s -m 30 -X POST -H "Content-Type: application/json" -H "$ACCEPTE" \
    -H "mcp-session-id: $SESSION" \
    -d '{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"stats","arguments":{}}}' \
    "$MCP_URL" || true)"
# Espaces toleres autour des deux-points ; « <<< » et non un tuyau, pour que
# « grep -q » qui s'arrete tot ne tue pas l'ecrivain sous pipefail.
if grep -qE '"isError" *: *true' <<< "$STATS"; then
    echec "le MCP n'a pas joint l'API : « stats » rend une erreur"
elif grep -qE '"result" *:' <<< "$STATS"; then
    ok "le MCP joint l'API (outil stats, par le tailnet)"
else
    echec "reponse illisible du MCP a « stats »"
fi

echo
echo "Ferme. Reste : une recherche depuis Claude Desktop (MCP -> API -> Ollama -> Qdrant),"
echo "et les ports de la machine de Mnemo dans la ronde — voir README.md."
