# Cénacle (ADR-0044, point 5): files the copies of the base pushed by the Mac,
# keeps them 7 days, and writes the verdict /var/lib/copie-cenacle/verdict.
# Installed by install-copie.sh, on the backup node only. A MALADE verdict
# fails the unit: `systemctl --failed` shows it too.
[Unit]
Description=Cénacle : ranger et juger les copies de la base
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/veiller-copie-cenacle
TimeoutStartSec=10min
# Root, because it must take files out of another account's folder and own
# what it keeps; boxed otherwise: no network, everything read-only but its
# two folders (followed if the store is a link to a volume), no home.
UMask=0077
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/cenacle-copie/ /var/lib/copie-cenacle
ProtectHome=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
