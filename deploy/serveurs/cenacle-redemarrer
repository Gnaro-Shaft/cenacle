#!/bin/bash
# cenacle-redemarrer (J6f2, ADR-0027): schedules a reboot of this machine in
# one minute — only if a reboot is required, only if the machine has been up
# for 24 hours, and, on a cluster node, only if the cluster is quorate with
# every node present and enough votes left while it is down, and no
# virtual machine or container still runs on it — a reboot would stop them;
# the node is emptied by hand first (migrate or stop), never by Cénacle. Started
# only through the `cenacle` account's key for this script (forced command,
# sudo for this script alone); no argument, nothing read from the caller.
# Exit code only: 0 reboot scheduled, 10 nothing to do, 11 refused by a
# guard, 12 failed. Every run leaves a line: journalctl -t cenacle.
# The minute lets the connection end cleanly, and leaves time to cancel by
# hand on the machine: shutdown -c.
set -u
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
readonly MIN_UPTIME_SECONDS=86400

log() { /usr/bin/logger -t cenacle -- "redemarrer: $*"; }

if [ "$#" -ne 0 ]; then log "refus: un argument a ete passe"; exit 11; fi
if [ "$(/usr/bin/id -u)" != "0" ]; then log "refus: pas root (sudo attendu)"; exit 11; fi
if [ ! -e /var/run/reboot-required ]; then log "rien a faire: aucun redemarrage demande"; exit 10; fi

uptime_s="$(/usr/bin/cut -d. -f1 /proc/uptime 2>/dev/null)"
if ! [[ "$uptime_s" =~ ^[0-9]{1,12}$ ]]; then log "refus: duree de fonctionnement illisible"; exit 11; fi
if [ "$uptime_s" -lt "$MIN_UPTIME_SECONDS" ]; then
  log "refus: redemarree il y a moins de 24 h"; exit 11
fi

# A cluster node: quorate, every expected vote present, and the votes left
# while this node is down still a strict majority — on two nodes without a
# QDevice, rebooting one would leave the other without quorum.
if [ -x /usr/bin/pvecm ]; then
  status="$(/usr/bin/pvecm status 2>/dev/null)" || { log "refus: pvecm status a echoue"; exit 11; }
  if ! printf '%s\n' "$status" | /usr/bin/grep -Eq '^Quorate:[[:space:]]+Yes'; then
    log "refus: grappe sans quorum"; exit 11
  fi
  expected="$(printf '%s\n' "$status" | /usr/bin/sed -n 's/^Expected votes:[[:space:]]*\([0-9]\{1,4\}\).*/\1/p')"
  total="$(printf '%s\n' "$status" | /usr/bin/sed -n 's/^Total votes:[[:space:]]*\([0-9]\{1,4\}\).*/\1/p')"
  if [ -z "$expected" ] || [ -z "$total" ]; then log "refus: sortie de pvecm illisible"; exit 11; fi
  if [ "$total" -lt "$expected" ]; then
    log "refus: il manque deja un noeud ($total/$expected votes)"; exit 11
  fi
  own="$(printf '%s\n' "$status" | /usr/bin/sed -n 's/^[[:space:]]*0x[0-9a-fA-F]\{1,8\}[[:space:]]\{1,\}\([0-9]\{1,4\}\)[[:space:]].*(local)[[:space:]]*$/\1/p')"
  if ! [[ "$own" =~ ^[0-9]{1,4}$ ]]; then log "refus: votes de ce noeud illisibles"; exit 11; fi
  if [ $(( (total - own) * 2 )) -le "$expected" ]; then
    log "refus: redemarrer ce noeud ferait perdre le quorum ($((total - own))/$expected votes restants)"; exit 11
  fi
fi

# Proxmox guests still running on this node (qm: VMs, pct: containers).
running=0
if [ -x /usr/sbin/qm ]; then
  vms="$(/usr/sbin/qm list 2>/dev/null)" || { log "refus: qm list a echoue"; exit 11; }
  running=$((running + $(printf '%s\n' "$vms" | /usr/bin/awk 'NR > 1 && $3 == "running" { c++ } END { print c + 0 }')))
fi
if [ -x /usr/sbin/pct ]; then
  cts="$(/usr/sbin/pct list 2>/dev/null)" || { log "refus: pct list a echoue"; exit 11; }
  running=$((running + $(printf '%s\n' "$cts" | /usr/bin/awk 'NR > 1 && $2 == "running" { c++ } END { print c + 0 }')))
fi
if [ "$running" -gt 0 ]; then
  log "refus: $running invite(s) en marche sur ce noeud (a migrer ou arreter d abord)"; exit 11
fi

if /usr/sbin/shutdown -r +1 "Cenacle: redemarrage demande (ADR-0027)" >/dev/null 2>&1; then
  log "fait: redemarrage programme dans 1 minute"; exit 0
fi
log "echec: shutdown"; exit 12
