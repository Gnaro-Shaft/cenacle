#!/bin/bash
# What a server says of itself (ADR-0039, version 2 by ADR-0040). Ported from
# Legion's legion-bulletin-hote (its ADR-029): the same idea, the same form —
# key=value lines between bulletin=1 and fin=1. Version 1 recited the measures
# the Parc tab shows; version 2 adds what the ronde judges: a reboot required,
# updates waiting, services on a replaced library, the cluster's quorum, the
# ports listening. Nothing else: no logs, no user, no address, no service name,
# no fail2ban or SSH counters (they are about third parties).
#
# STRICTLY READ-ONLY: it writes nothing, installs nothing, changes nothing.
# Two commands go through sudo, both list-only and frozen in
# /etc/sudoers.d/cenacle, without any free argument (install.sh):
#   /usr/sbin/needrestart -r l -b     (list, never restart)
#   /usr/bin/pvecm status             (a cluster node only)
# The key that calls it is locked on the server side:
#   command="/usr/local/bin/cenacle-bulletin",restrict,from="<the Mac>"
# Its own key: never one of the operator's action keys (ADR-0027).
#
# A FACT THAT COULD NOT BE READ IS NOT SAID — never said as 0. A failed
# command, a refused sudo, an output out of shape: the key is left out, and
# the reader on the Mac takes it as unknown.
#
# The original lives in Cénacle's repository, deploy/serveurs/; a change made
# on the server is lost at the next install.

set -u
export LC_ALL=C

# printf, not echo: a value starting with "-e" would be taken as an option.
say() { printf '%s=%s\n' "$1" "$2"; }
# An empty value is a fact that could not be read: not said at all.
say_if() { [ -n "${2:-}" ] && say "$1" "$2"; }
# A count: said only when it is one (digits only), else not said at all.
say_count() { [[ "${2:-}" =~ ^[0-9]{1,9}$ ]] && say "$1" "$2"; }

printf 'bulletin=1\n'
say version 2
# The name only as a plain label (identity comes from the pinned host key):
# anything but letters, digits, dots and dashes becomes a dash, 63 at most.
h="$(hostname 2>/dev/null)"
h="$(printf '%s' "$h" | tr -c 'A-Za-z0-9.-' '-' | sed 's/^[^A-Za-z0-9]*//' | cut -c1-63)"
say hote "${h:-inconnu}"
say instant "$(date -u +%s)"
say_if uptime "$(cut -d' ' -f1 /proc/uptime 2>/dev/null | cut -d. -f1)"

# Load, in hundredths: whole numbers only, never a decimal separator to guess.
if [ -r /proc/loadavg ]; then
    read -r c1 c5 c15 _ < /proc/loadavg
    say_if charge1 "$(awk -v v="$c1" 'BEGIN { printf "%d", v * 100 + 0.5 }')"
    say_if charge5 "$(awk -v v="$c5" 'BEGIN { printf "%d", v * 100 + 0.5 }')"
    say_if charge15 "$(awk -v v="$c15" 'BEGIN { printf "%d", v * 100 + 0.5 }')"
fi
say_if processeurs "$(nproc 2>/dev/null)"

if [ -r /proc/meminfo ]; then
    say_if memoire.totale "$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)"
    say_if memoire.disponible "$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)"
fi

# Real file systems only (a full tmpfs is normal), and only the mounts that
# matter, as Legion does; numbered, so that a path never becomes a key.
n=0
while read -r _ blocks _ _ percent mount; do
    case "$mount" in
        /|/var|/home|/srv|/opt|/boot|/var/lib/vz)
            # A file system without blocks says "-": not a disk to show.
            case "${percent%\%}${blocks}" in ''|*[!0-9]*) continue ;; esac
            n=$((n + 1))
            say "disque.$n.montage" "$mount"
            say "disque.$n.pourcent" "${percent%\%}"
            say "disque.$n.kilooctets" "$blocks"
            ;;
    esac
done < <(df -P -l -x tmpfs -x devtmpfs -x squashfs -x overlay 2>/dev/null | tail -n +2)

# ── Version 2: what the ronde judges ─────────────────────────────────────────

# A patched kernel that is not loaded patches nothing. Always said: a file
# present or absent cannot fail to be read.
if [ -f /var/run/reboot-required ] || [ -f /run/reboot-required ]; then
    say redemarrage requis
else
    say redemarrage non
fi

# Every outside command has its own time limit (coreutils' timeout): the Mac
# gives the whole bulletin 20 s, and a hung pmxcfs or a slow needrestart must
# cost its own fact, never the whole bulletin — least of all when the cluster
# is the thing that is broken. A command cut off says nothing.

# Updates waiting. Ubuntu's apt-check says "total;security" on stderr; on
# Debian and Proxmox, a simulation that locks nothing and writes nothing.
# Unlike Legion's bulletin, a failed command or an answer out of shape says
# nothing at all — Legion's counted an apt-get that failed as 0 updates.
# Known limit (as Legion's): the count is as fresh as the apt lists.
if [ -x /usr/lib/update-notifier/apt-check ]; then
    if verdict="$(timeout 6 /usr/lib/update-notifier/apt-check 2>&1 >/dev/null)" &&
        [[ "$verdict" =~ ^([0-9]{1,9})\;([0-9]{1,9})$ ]]; then
        say maj.total "${BASH_REMATCH[1]}"
        say maj.securite "${BASH_REMATCH[2]}"
    fi
elif command -v apt-get >/dev/null 2>&1; then
    if simulated="$(timeout 6 apt-get -s -o Debug::NoLocking=true dist-upgrade 2>/dev/null)"; then
        installs="$(printf '%s\n' "$simulated" | grep '^Inst ')"
        say_count maj.total "$(printf '%s' "$installs" | grep -c .)"
        # "security" in the origin, between the parentheses — not in a
        # package's name: "Inst name [old] (new Origin:Release [arch])".
        say_count maj.securite "$(printf '%s' "$installs" | grep -Eci '^Inst [^(]*\([^)]*security')"
    fi
fi

# Services still running on a replaced library: their number only — a list
# of services is a map of the machine. Legion's three traps (25/09/2026):
# needrestart lives in /usr/sbin, out of an ordinary account's PATH (hence
# the absolute path); the account may run only named commands (hence the real
# command, not `sudo -n true`); a refused sudo gives an empty output, which a
# count would take for 0 (hence: a count only from a command that succeeded
# and answered in needrestart's own batch form). timeout goes OUTSIDE sudo:
# the frozen rule names needrestart itself.
NEEDRESTART=/usr/sbin/needrestart
if [ -x "$NEEDRESTART" ] &&
    waiting="$(timeout 4 sudo -n "$NEEDRESTART" -r l -b 2>/dev/null)" &&
    printf '%s\n' "$waiting" | grep -q '^NEEDRESTART-VER:'; then
    say_count services.a_relancer "$(printf '%s\n' "$waiting" | grep -c '^NEEDRESTART-SVC:')"
fi

# The cluster's quorum, on a member of a Proxmox cluster only — known by its
# local corosync configuration (/etc/corosync, not /etc/pve: the latter
# vanishes exactly when the cluster file system is down). Off a cluster,
# nothing is said and nothing is expected. A member whose pvecm does not
# answer is said "illisible": a pvecm that does not answer is not a quorum.
# Directly if the account can, else by sudo (the frozen rule).
PVECM=/usr/bin/pvecm
if [ -x "$PVECM" ] && [ -e /etc/corosync/corosync.conf ]; then
    cluster="$(timeout 2 "$PVECM" status 2>/dev/null)"
    printf '%s\n' "$cluster" | grep -qE '^Quorate:' ||
        cluster="$(timeout 3 sudo -n "$PVECM" status 2>/dev/null)"
    read_cluster() {
        printf '%s\n' "$cluster" |
            awk -F: -v key="$1" '$1 == key { gsub(/[[:space:]]/, "", $2); print $2; exit }'
    }
    case "$(read_cluster Quorate)" in
        Yes) say grappe.quorum oui ;;
        No) say grappe.quorum non ;;
        *) say grappe.quorum illisible ;;
    esac
    say_count grappe.votes "$(read_cluster 'Total votes')"
    say_count grappe.attendus "$(read_cluster 'Expected votes')"
fi

# What listens: the protocol and the port, never an address. The bound
# address is CLASSED — "local/" (loopback), "tailnet/" (Tailscale's ranges,
# 100.64.0.0/10 and fd7a:115c:a1e0::/48) or nothing — so that a back door on
# 0.0.0.0:53 is not mistaken for the resolver on 127.0.0.53; the address
# itself is never said. An IPv4 address written as IPv6 (::ffff:a.b.c.d) is
# classed as the IPv4 one.
#
# A UDP PORT COUNTS ONLY IF IT LASTS: `ss -lu` lists every bound, unconnected
# UDP socket, and tailscaled opens short-lived ones on random ports every
# twenty to thirty seconds (Legion, 27/09/2026). So ss is read twice, a second
# apart, and only the UDP sockets present in both readings are said. TCP is
# not filtered: a TCP socket listening is always a service. Both readings are
# the SAME command: `ss -lnu` alone has no protocol column.
#
# NEVER A PARTIAL LIST, NEVER AN ADDRESS BY MISTAKE: if either reading fails,
# or a single line is out of the expected form (a protocol other than tcp or
# udp, no "address:port", a port that is not 1 to 65535), no port is said at
# all — "unknown". Nothing is printed until every line has been read.
if command -v ss >/dev/null 2>&1; then
    if first="$(timeout 2 ss -H -lntu 2>/dev/null)" && sleep 1 &&
        second="$(timeout 2 ss -H -lntu 2>/dev/null)" &&
        listed="$(awk '
            NR == FNR { if ($1 == "udp") lasting[$5] = 1; next }
            $1 != "udp" || ($5 in lasting)
            ' <(printf '%s\n' "$second") <(printf '%s\n' "$first") |
            awk '
            function plain(a) {
                sub(/%.*$/, "", a); gsub(/\[|\]/, "", a); a = tolower(a);
                sub(/^::ffff:/, "", a);
                return a;
            }
            function tailnet(a,   o) {
                if (a ~ /^fd7a:115c:a1e0:/) return 1;
                if (split(a, o, ".") != 4 || o[1] != "100" || o[2] !~ /^[0-9]+$/) return 0;
                return o[2] + 0 >= 64 && o[2] + 0 <= 127;
            }
            NF == 0 { next }
            {
                if (($1 != "tcp" && $1 != "udp") || NF < 5) { bad = 1; next }
                n = split($5, f, ":");
                port = f[n];
                # No {m,n} in the regex: older mawk, the awk of Debian, does not read it.
                if (n < 2 || port !~ /^[1-9][0-9]*$/ || length(port) > 5 || port + 0 > 65535) { bad = 1; next }
                bound = $5; raw = substr(bound, 1, length(bound) - length(port) - 1);
                address = plain(raw);
                if (address ~ /^127\./ || address == "::1" || raw ~ /%lo$/)
                    scope = "local/";
                else if (tailnet(address))
                    scope = "tailnet/";
                else
                    scope = "";
                out[++count] = scope $1 "/" port;
            }
            END {
                if (bad) exit 1;
                for (i = 1; i <= count; i++) print out[i];
            }')"; then
        say_if ports "$(printf '%s\n' "$listed" | sort -u | grep . | paste -sd, -)"
    fi
fi

printf 'fin=1\n'
